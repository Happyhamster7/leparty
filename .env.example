# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# The service role key. Server-side only: never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anything you like. Gates the /host console.
HOST_PASSCODE=warden

# Used to build invite links. No trailing slash.
# Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Shared with the Shifty Shen's Slammer game app (its LEPARTY_SECRET). Lets
# it read checked-in guests and blocks from /api/sss/*. Leave unset to keep
# those endpoints off.
SSS_ROSTER_SECRET=
